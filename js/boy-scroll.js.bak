/* ==========================================================================
   Kidysport — scroll-driven boy animation across the first four sections.

   The three source clips are alpha WebM (VP9). Safari will not composite VP9
   alpha and iOS throttles programmatic `currentTime` seeking, so each clip is
   decoded once to a 60-frame WebP-alpha sequence (assets/seq) and played back
   on a canvas: same motion, every browser, no seek stalls.

   Frame 0 of each clip is the pose of the outgoing section's static PNG and
   the last frame is the pose of the incoming one. Both the frames and the
   static PNGs are measured by their alpha bounding box, so the boy lands
   exactly on the Figma position at each section boundary.
   ========================================================================== */
(function () {
  'use strict';

  var CLIPS = ['t1', 't2', 't3'];

  /* Frames normally stream from assets/seq. A self-contained build (e.g. a
     shareable single-file preview) can inject them instead as
     window.KIDY_SEQ = { t1: [...urls], t2: [...], t3: [...] }. */
  var SEQ = window.KIDY_SEQ || null;
  var PER_CLIP = SEQ ? SEQ.t1.length : 60;
  function frameSrc(tag, i) {
    return SEQ ? SEQ[tag][i] : 'assets/seq/' + tag + '_' + pad(i) + '.webp';
  }

  var canvas = document.getElementById('boy-canvas');
  if (!canvas) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var ctx = canvas.getContext('2d');

  /* Desktop runs four poses over three clips. The mobile frame repeats the
     ball pose in the strength-cards band, so there it is five poses: the third
     clip is split into a "hold" (pose fixed, boy travels to the repeat) and the
     usual scrub from there to the swing. */
  var heroBoy   = document.querySelector('.hero__boy');
  var howBoy    = document.querySelector('.how__boy');
  var whatisBoy = document.querySelector('.whatis__boy');
  var strengthBoy = document.querySelector('.strength__boy');
  var planBoy   = document.querySelector('.plan__boy');

  var secHero   = document.getElementById('hero');
  var secHow    = document.getElementById('how');
  var secWhatis = document.getElementById('what-is');
  var secPlan   = document.getElementById('plan');

  if (!heroBoy || !howBoy || !whatisBoy || !planBoy ||
      !secHero || !secHow || !secWhatis || !secPlan) return;

  var statics = [];   // anchor elements, in order
  var segs    = [];   // {clip, hold} per gap between anchors
  var boundFns = [];  // scroll position where each anchor is "on its mark"

  function pageTop(el) { return el.getBoundingClientRect().top + window.scrollY; }
  function pageBottom(el) { return pageTop(el) + el.getBoundingClientRect().height; }

  function buildChain() {
    var useStrength = strengthBoy &&
      window.getComputedStyle(strengthBoy).display !== 'none';

    if (useStrength) {
      statics  = [heroBoy, howBoy, whatisBoy, strengthBoy, planBoy];
      boundFns = [
        function () { return pageTop(secHero); },
        function () { return pageTop(secHow); },
        function () { return pageTop(secWhatis); },
        function () { return pageBottom(secWhatis); },   /* strength band starts */
        function () { return pageTop(secPlan); }
      ];
      segs = [{ clip: 0 }, { clip: 1 }, { clip: 2, hold: true }, { clip: 2 }];
    } else {
      statics  = [heroBoy, howBoy, whatisBoy, planBoy];
      boundFns = [
        function () { return pageTop(secHero); },
        function () { return pageTop(secHow); },
        function () { return pageTop(secWhatis); },
        function () { return pageTop(secPlan); }
      ];
      segs = [{ clip: 0 }, { clip: 1 }, { clip: 2 }];
    }
  }
  buildChain();

  var frames  = [];   // frames[clip][i]
  var edgeBox = [];   // edgeBox[clip] = {first, last} alpha boxes in frame px
  var staticBox = []; // alpha box of each static PNG, as a 0-1 fraction
  var anchors = [];   // tight page-space rect of the boy per section
  var tops    = [];
  var frameW = 0, frameH = 0;
  var ready = false;
  var dpr = 1;

  function loadImage(src) {
    return new Promise(function (res, rej) {
      var img = new Image();
      img.decoding = 'async';
      img.onload = function () { res(img); };
      img.onerror = rej;
      img.src = src;
    });
  }
  function pad(n) { return String(n).padStart(3, '0'); }

  /* Alpha bounding box, measured on a small proxy for speed. */
  function alphaBox(img) {
    var W = 200;
    var H = Math.max(1, Math.round(W * img.naturalHeight / img.naturalWidth));
    var c = document.createElement('canvas');
    c.width = W; c.height = H;
    var cx = c.getContext('2d', { willReadFrequently: true });
    cx.drawImage(img, 0, 0, W, H);
    var d;
    try { d = cx.getImageData(0, 0, W, H).data; }
    catch (e) { return { x: 0, y: 0, w: img.naturalWidth, h: img.naturalHeight }; }
    var minX = W, minY = H, maxX = -1, maxY = -1;
    for (var y = 0; y < H; y++) {
      for (var x = 0; x < W; x++) {
        if (d[(y * W + x) * 4 + 3] > 24) {
          if (x < minX) minX = x;
          if (x > maxX) maxX = x;
          if (y < minY) minY = y;
          if (y > maxY) maxY = y;
        }
      }
    }
    if (maxX < 0) return { x: 0, y: 0, w: img.naturalWidth, h: img.naturalHeight };
    var sx = img.naturalWidth / W, sy = img.naturalHeight / H;
    return {
      x: minX * sx, y: minY * sy,
      w: (maxX - minX + 1) * sx, h: (maxY - minY + 1) * sy
    };
  }

  /* same, but normalised to 0-1 so it can be applied to any rendered size */
  function alphaFraction(img) {
    var b = alphaBox(img);
    return {
      x: b.x / img.naturalWidth,  y: b.y / img.naturalHeight,
      w: b.w / img.naturalWidth,  h: b.h / img.naturalHeight
    };
  }

  function decoded(img) {
    if (img.complete && img.naturalWidth) return Promise.resolve(img);
    return new Promise(function (res) {
      img.addEventListener('load', function () { res(img); }, { once: true });
      img.addEventListener('error', function () { res(img); }, { once: true });
    });
  }

  function boot() {
    var edges = [];
    CLIPS.forEach(function (tag) {
      edges.push(loadImage(frameSrc(tag, 0)));
      edges.push(loadImage(frameSrc(tag, PER_CLIP - 1)));
    });

    Promise.all([
      Promise.all(edges),
      Promise.all(statics.map(decoded))
    ]).then(function (both) {
      var imgs = both[0];
      frameW = imgs[0].naturalWidth;
      frameH = imgs[0].naturalHeight;

      CLIPS.forEach(function (tag, k) {
        frames[k] = new Array(PER_CLIP);
        frames[k][0] = imgs[k * 2];
        frames[k][PER_CLIP - 1] = imgs[k * 2 + 1];
        edgeBox[k] = { first: alphaBox(imgs[k * 2]), last: alphaBox(imgs[k * 2 + 1]) };
      });

      staticBox = statics.map(function (img) {
        return img.naturalWidth ? alphaFraction(img) : { x: 0, y: 0, w: 1, h: 1 };
      });

      measure();
      ready = true;
      document.documentElement.classList.add('js-boy-anim');
      canvas.classList.add('is-live');
      wire();
      render();
      streamRest();
    }).catch(function () {
      /* no sequence available — the static Figma composition stays as-is */
    });
  }

  function streamRest() {
    var queue = [];
    CLIPS.forEach(function (tag, k) {
      for (var i = 1; i < PER_CLIP - 1; i++) queue.push([k, tag, i]);
    });
    var at = 0;
    function next() {
      if (at >= queue.length) return;
      var job = queue[at++];
      loadImage(frameSrc(job[1], job[2]))
        .then(function (img) { frames[job[0]][job[2]] = img; })
        .catch(function () {})
        .then(next);
    }
    next(); next(); next();
  }

  /* Tight page-space rect of the boy inside a static <img>. */
  function tightRect(el, frac) {
    var r = el.getBoundingClientRect();
    return {
      x: r.left + window.scrollX + frac.x * r.width,
      y: r.top + window.scrollY + frac.y * r.height,
      w: frac.w * r.width,
      h: frac.h * r.height
    };
  }

  function measure() {
    /* A window "load" or a ScrollTrigger refresh can land before the alpha
       boxes exist; there is nothing to place until then. */
    if (staticBox.length !== statics.length) return;

    dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width  = Math.round(window.innerWidth * dpr);
    canvas.height = Math.round(window.innerHeight * dpr);
    canvas.style.width = window.innerWidth + 'px';
    canvas.style.height = window.innerHeight + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    anchors = statics.map(function (el, i) { return tightRect(el, staticBox[i]); });
    tops = boundFns.map(function (fn) { return fn(); });
  }

  function layerFor(box, anchor) {
    var scale = anchor.w / box.w;
    return { scale: scale, x: anchor.x - box.x * scale, y: anchor.y - box.y * scale };
  }
  function lerp(a, b, t) { return a + (b - a) * t; }

  var lastKey = '';

  /* Set by the ScrollTrigger scrubs; falls back to raw scroll maths when
     ScrollTrigger is unavailable. */
  var cur = { k: 0, p: 0 };

  function readScroll() {
    var scrollY = window.scrollY;
    var last = segs.length - 1;
    if (scrollY <= tops[0]) return { k: 0, p: 0 };
    if (scrollY >= tops[last + 1]) return { k: last, p: 1 };
    for (var i = 0; i <= last; i++) {
      if (scrollY >= tops[i] && scrollY < tops[i + 1]) {
        return { k: i, p: (scrollY - tops[i]) / Math.max(1, tops[i + 1] - tops[i]) };
      }
    }
    return cur;
  }

  function render() {
    if (!ready) return;

    var scrollY = window.scrollY;
    var k = Math.min(cur.k, segs.length - 1), p = cur.p;
    var seg = segs[k];
    var clip = seg.clip;

    /* On a hold segment the pose stays on the clip's first frame while the boy
       travels between the two anchors that share it. */
    var from = layerFor(edgeBox[clip].first, anchors[k]);
    var to   = layerFor(seg.hold ? edgeBox[clip].first : edgeBox[clip].last, anchors[k + 1]);

    var scale = lerp(from.scale, to.scale, p);
    var x = lerp(from.x, to.x, p) - window.scrollX;
    var y = lerp(from.y, to.y, p) - scrollY;
    var w = frameW * scale;
    var h = frameH * scale;

    if (y > window.innerHeight || y + h < 0) {
      if (lastKey !== 'blank') {
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
        lastKey = 'blank';
      }
      return;
    }

    var idx = seg.hold ? 0 : Math.round(p * (PER_CLIP - 1));
    var img = frames[clip][idx];
    if (!img) {
      for (var d = 1; d < PER_CLIP && !img; d++) {
        img = frames[clip][idx - d] || frames[clip][idx + d];
      }
    }
    if (!img) return;

    var key = clip + ":" + idx + ':' + Math.round(x) + ':' + Math.round(y) + ':' + Math.round(w);
    if (key === lastKey) return;
    lastKey = key;

    ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
    ctx.drawImage(img, x, y, w, h);
  }

  function onResize() { measure(); lastKey = ''; cur = readScroll(); render(); }

  var useGsap = !!(window.gsap && window.ScrollTrigger);

  function wire() {
    if (!useGsap) {
      var raw = function () { cur = readScroll(); render(); };
      window.addEventListener('scroll', raw, { passive: true });
      raw();
      return;
    }

    gsap.registerPlugin(ScrollTrigger);

    /* One scrub per transition: section N's top → section N+1's top. That is
       exactly where Figma places the two poses, so the boy is on his marks at
       both ends and interpolates in between. */
    segs.forEach(function (seg, i) {
      ScrollTrigger.create({
        trigger: document.body,
        start: function () { return tops[i]; },
        end:   function () { return tops[i + 1]; },
        scrub: true,
        onUpdate: function (self) { cur = { k: i, p: self.progress }; },
        onRefresh: function () { measure(); lastKey = ""; }
      });
    });

    /* Redraw on GSAP's ticker so the canvas follows the smoothed scrub. */
    gsap.ticker.add(render);
    cur = readScroll();
  }

  window.addEventListener('resize', function () {
    if (useGsap) ScrollTrigger.refresh(); else onResize();
  });
  window.addEventListener('load', onResize);

  if (document.readyState !== 'loading') boot();
  else document.addEventListener('DOMContentLoaded', boot);
})();
